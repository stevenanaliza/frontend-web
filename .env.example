# Origen del backend Corporate, sin /api/v1/. No colocar secretos aquí.
VITE_API_URL=
# Solo para npm run dev: enviar /api/v1/ a Vite y reenviar al origen configurado.
VITE_API_PROXY=false
# Clave web restringida por referente HTTP y a Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# ID de mapa de Google Cloud; vacío utiliza DEMO_MAP_ID para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=
